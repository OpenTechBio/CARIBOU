{
  "$defs": {
    "CheckpointComponent": {
      "enum": [
        "dataset_state",
        "message_history",
        "agent_state",
        "executed_actions",
        "artifact_manifest",
        "random_state"
      ],
      "title": "CheckpointComponent",
      "type": "string"
    },
    "CheckpointStatus": {
      "enum": [
        "complete",
        "invalid",
        "incompatible"
      ],
      "title": "CheckpointStatus",
      "type": "string"
    }
  },
  "$id": "https://caribou.dev/schemas/domain/v1/checkpoint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_state_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent State Artifact Id"
    },
    "artifact_manifest_id": {
      "pattern": "^art_[0-9a-f]{32}$",
      "title": "Artifact Manifest Id",
      "type": "string"
    },
    "checkpoint_id": {
      "pattern": "^chk_[0-9a-f]{32}$",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "code_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Code Commit",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/CheckpointComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "container_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Container Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Artifact Id"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{32}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_sequence": {
      "minimum": 0,
      "title": "Event Sequence",
      "type": "integer"
    },
    "executed_actions_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executed Actions Artifact Id"
    },
    "experiment_id": {
      "pattern": "^exp_[0-9a-f]{32}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "integrity_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Integrity Hash",
      "type": "string"
    },
    "message_history_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message History Artifact Id"
    },
    "model_identity": {
      "minLength": 1,
      "title": "Model Identity",
      "type": "string"
    },
    "parent_checkpoint_id": {
      "anyOf": [
        {
          "pattern": "^chk_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Checkpoint Id"
    },
    "random_state_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Random State Artifact Id"
    },
    "resume_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Resume Requirements",
      "type": "array"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "caribou.checkpoint.v1",
      "default": "caribou.checkpoint.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Spec Hash",
      "type": "string"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CheckpointStatus",
      "default": "complete"
    },
    "turn": {
      "minimum": 0,
      "title": "Turn",
      "type": "integer"
    }
  },
  "required": [
    "experiment_id",
    "run_id",
    "event_id",
    "event_sequence",
    "stage",
    "turn",
    "components",
    "artifact_manifest_id",
    "spec_hash",
    "code_commit",
    "container_digest",
    "model_identity",
    "integrity_hash"
  ],
  "title": "Checkpoint",
  "type": "object"
}
